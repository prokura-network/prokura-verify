{
  "name": "@prokura/verify",
  "version": "0.1.0",
  "description": "Offline verifier for Prokura Nachweis exports, signed roots and checkpoints, and Merkle inclusion proofs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "prokura-verify": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "tsx src/cli.ts"
  },
  "dependencies": {
    "canonicalize": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
